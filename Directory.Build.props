<Project>
  <!-- Licence and authorship for every iSheet Core module. Each source file carries an SPDX line (see tools\add-spdx.ps1). -->
  <PropertyGroup>
    <SheetCoreLicense>LGPL-3.0-or-later</SheetCoreLicense>
    <SheetCoreCopyright>Copyright (C) 2026 Luminiz Technologies Limited</SheetCoreCopyright>
  </PropertyGroup>

  <PropertyGroup>
    <Configuration Condition="'$(Configuration)' == ''">Debug</Configuration>
    <Platform Condition="'$(Platform)' == ''">x64</Platform>
    <PlatformToolset>v143</PlatformToolset>
    <WindowsTargetPlatformVersion>10.0</WindowsTargetPlatformVersion>
    <CharacterSet>Unicode</CharacterSet>
    <SheetCoreRoot>$(MSBuildThisFileDirectory)</SheetCoreRoot>
    <OutDir>$(SheetCoreRoot)build\bin\$(Configuration)\$(Platform)\</OutDir>
    <IntDir>$(SheetCoreRoot)build\obj\$(MSBuildProjectName)\$(Configuration)\$(Platform)\</IntDir>
  </PropertyGroup>

  <ItemDefinitionGroup>
    <ClCompile>
      <LanguageStandard>stdcpp20</LanguageStandard>
      <WarningLevel>Level4</WarningLevel>
      <ConformanceMode>true</ConformanceMode>
      <MultiProcessorCompilation>true</MultiProcessorCompilation>
      <SDLCheck>true</SDLCheck>
      <AdditionalOptions>/utf-8 %(AdditionalOptions)</AdditionalOptions>
      <RuntimeLibrary Condition="'$(Configuration)' == 'Debug'">MultiThreadedDebugDLL</RuntimeLibrary>
      <RuntimeLibrary Condition="'$(Configuration)' == 'Release'">MultiThreadedDLL</RuntimeLibrary>
      <PreprocessorDefinitions Condition="'$(Configuration)' == 'Debug'">_DEBUG;NOMINMAX;WIN32_LEAN_AND_MEAN;%(PreprocessorDefinitions)</PreprocessorDefinitions>
      <PreprocessorDefinitions Condition="'$(Configuration)' == 'Release'">NDEBUG;NOMINMAX;WIN32_LEAN_AND_MEAN;%(PreprocessorDefinitions)</PreprocessorDefinitions>
    </ClCompile>
    <Link>
      <SubSystem>Console</SubSystem>
      <GenerateDebugInformation>true</GenerateDebugInformation>
    </Link>
  </ItemDefinitionGroup>
</Project>
